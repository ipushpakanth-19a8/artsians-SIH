datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role         String    @default("seller") // 'seller' | 'buyer' | 'admin'
  status       String    @default("active") // 'active' | 'deactivated' | 'suspended'
  craft_type   String?
  business_name String?
  location     String?
  state        String?
  address      String?
  artisan_id   String?
  last_login   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  hasCompletedBuyerOnboarding Boolean   @default(false)
  hasCompletedSellerOnboarding Boolean  @default(false)
  artisan      Artisan?  @relation(fields: [artisan_id], references: [id])
  buyerOrders  Order[]   @relation("BuyerOrders")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Artisan {
  id                String    @id
  user_id           String?
  name              String
  category          String
  state             String
  district          String
  bio               String    @db.Text
  experience_years  Int       @default(5)
  profile_image_url String    @db.Text
  phone             String
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  users             User[]
  products          Product[]
  orders            Order[]
  enquiries         Enquiry[]
  bills             Bill[]

  @@index([category])
  @@index([district, state])
  @@map("artisans")
}

model Product {
  id                          String    @id
  artisan_id                  String
  artisan_name                String
  artisan_category            String
  artisan_district            String
  artisan_state               String
  artisan_phone               String?
  title                       String
  description                 String    @db.Text
  short_description           String?   @db.Text
  b2b_description             String?   @db.Text
  social_caption              String?   @db.Text
  category                    String
  subcategory                 String?
  craft_technique             String?
  motifs                      Json?     @default("[]")
  colors                      Json?     @default("[]")
  tags                        Json      @default("[]")
  material                    String
  est_dimensions              String
  weight                      String?
  base_language               String    @default("en")
  original_image_url          String    @db.Text
  enhanced_image_url          String    @db.Text
  image_variants              Json?
  enhancement_applied         Boolean   @default(false)
  status                      String    @default("draft") // 'draft' | 'published' | 'disabled' | 'rejected'
  validation_status           String?
  gi_status                   String?
  gi_certificate_number       String?
  cost                        Json      // ProductCost object
  pricing                     Json?     // PriceRecommendation object
  final_price                 Float
  b2b_price                   Float?
  minimum_order_quantity      Int?      @default(1)
  production_capacity_monthly Int?      @default(20)
  lead_time_days              Int?      @default(7)
  customization_available     Boolean?  @default(false)
  sample_available            Boolean?  @default(false)
  seen_at_exhibition          Json?
  translations                Json      @default("{}")
  market_linkage              Json      @default("[]")
  views_count                 Int       @default(0)
  enquiry_count               Int       @default(0)
  quantity                    Int?      @default(1)
  location                    String?
  craft_origin                String?
  materialCost                Float?    @default(0)
  laborHours                  Float?    @default(0)
  fairHourlyWage              Float?    @default(100)
  laborValue                  Float?    @default(0)
  baseCost                    Float?    @default(0)
  marginAmount                Float?    @default(0)
  recommendedFairPrice        Float?    @default(0)
  artisanApprovedPrice        Float?    @default(0)
  pricingFormulaVersion       String?   @default("v1.0-living-wage")
  pricingCalculatedAt         DateTime? @default(now())
  published_at                DateTime?
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @updatedAt

  artisan                     Artisan   @relation(fields: [artisan_id], references: [id])
  images                      ProductImage[]
  orders                      Order[]
  enquiries                   Enquiry[]
  bills                       Bill[]
  auditLogs                   AIProcessingResult[]

  @@index([category])
  @@index([status])
  @@index([artisan_id])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(cuid())
  product_id   String
  url          String   @db.Text
  variant_type String?  // 'original' | 'enhanced' | 'thumbnail' | 'square' | 'portrait'
  created_at   DateTime @default(now())

  product      Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_images")
}

model MarketPriceBenchmark {
  id                    String    @id
  category              String
  material              String?
  craft_name            String
  craft_type            String?
  region                String
  price_low             Float
  price_high            Float
  average_price         Float
  target_recommended    Float?
  typical_middleman_cut Float     @default(60)
  source                String
  recorded_at           DateTime?
  last_updated          DateTime  @default(now())

  @@index([category])
  @@index([craft_type])
  @@map("market_price_benchmarks")
}

model BuyerChannel {
  id                 String   @id
  name               String
  channel_type       String   // 'local_retail' | 'boutique' | 'export' | 'institutional' | 'direct_social'
  typical_price_tier String
  category_fit       Json     @default("[]")
  description        String   @db.Text
  margin_fee_pct     Float
  settlement_speed   String

  @@map("buyer_channels")
}

model Order {
  id                  String   @id
  product_id          String
  product_title       String
  artisan_id          String
  artisan_name        String
  buyer_id            String?
  buyer_name          String
  buyer_contact       String
  buyer_email         String?
  buyer_address       String?  @db.Text
  quantity            Int      @default(1)
  unit_price          Float
  total_amount        Float
  status              String   @default("created") // 'created' | 'paid' | 'shipped' | 'delivered'
  payment_id          String?
  payment_method      String   @default("upi_direct") // 'razorpay_test' | 'upi_direct' | 'cash_on_delivery'
  fair_trade_verified Boolean  @default(true)
  recommended_fair_price Float?
  artisan_approved_price Float?
  fair_price_breakdown Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  product             Product  @relation(fields: [product_id], references: [id])
  artisan             Artisan  @relation(fields: [artisan_id], references: [id])
  buyer               User?    @relation("BuyerOrders", fields: [buyer_id], references: [id])

  @@index([artisan_id])
  @@index([product_id])
  @@index([status])
  @@map("orders")
}

model Bill {
  id                 String    @id
  billNumber         String    @unique
  sellerId           String
  sellerName         String
  sellerPhone        String
  sellerLocation     String
  productId          String
  productName        String
  productCategory    String
  quantity           Int       @default(1)
  materialCost       Float     @default(0)
  labourCost         Float     @default(0)
  transportationCost Float     @default(0)
  otherCost          Float     @default(0)
  totalCost          Float     @default(0)
  proposedPrice      Float     @default(0)
  marketMinPrice     Float     @default(0)
  marketAveragePrice Float     @default(0)
  marketMaxPrice     Float     @default(0)
  recommendedPrice   Float     @default(0)
  finalPrice         Float     @default(0)
  profit             Float     @default(0)
  profitPercentage   Float     @default(0)
  fairHourlyWage     Float?    @default(100)
  laborHours         Float?    @default(0)
  laborValue         Float?    @default(0)
  baseCost           Float?    @default(0)
  marginAmount       Float?    @default(0)
  recommendedFairPrice Float?  @default(0)
  artisanApprovedPrice Float?  @default(0)
  pricingFormulaVersion String? @default("v1.0-living-wage")
  status             String    @default("draft") // 'draft' | 'finalized'
  createdAt          DateTime  @default(now())
  finalizedAt        DateTime?

  product            Product   @relation(fields: [productId], references: [id])
  seller             Artisan   @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([productId])
  @@map("bills")
}

model Enquiry {
  id            String   @id
  product_id    String
  product_title String
  artisan_id    String
  buyer_name    String
  buyer_contact String
  buyer_email   String?
  buyer_location String
  quantity      Int      @default(1)
  message       String   @db.Text
  status        String   @default("new") // 'new' | 'responded'
  created_at    DateTime @default(now())

  product       Product  @relation(fields: [product_id], references: [id])
  artisan       Artisan  @relation(fields: [artisan_id], references: [id])

  @@index([artisan_id])
  @@index([product_id])
  @@map("enquiries")
}

model AIProcessingResult {
  id                   String   @id
  product_id           String?
  feature              String   // 'enhancement' | 'catalog' | 'translation' | 'pricing' | 'matching'
  model_used           String
  latency_ms           Int
  status               String   // 'success' | 'fallback' | 'failed'
  raw_input_summary    String   @db.Text
  raw_response_summary String   @db.Text
  created_at           DateTime @default(now())

  product              Product? @relation(fields: [product_id], references: [id])

  @@index([product_id])
  @@index([feature])
  @@map("ai_processing_results")
}

model OtpVerification {
  id         String   @id @default(cuid())
  phone      String
  otp        String
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([phone])
  @@map("otp_verifications")
}
