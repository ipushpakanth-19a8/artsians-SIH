# ==============================================================================
# KALAtech — Environment Configuration (.env.example)
# AI-Driven Market Linkage and Smart Cataloging Mobile Application for Marginalized Artisans
# ==============================================================================

# Database (PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalatech?schema=public"

# Authentication & Security
JWT_SECRET="kalatech-super-secret-jwt-key-change-in-production-2026"

# AI: Gemini Multimodal & Google Cloud Vision
GEMINI_API_KEY="your_gemini_api_key_here"
GOOGLE_CLOUD_PROJECT_ID="your_google_cloud_project_id"
GOOGLE_APPLICATION_CREDENTIALS="path/to/google_credentials.json"

# Payments (Kept behind service layer)
PAYMENT_PROVIDER_KEY="rzp_test_your_key_id"
PAYMENT_PROVIDER_SECRET="your_payment_provider_secret"

# Market Linkage: WhatsApp Business API (Runs in structured Demo mode if blank)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Market Linkage: ONDC Beckn Network Protocol (Default: demo mode)
ONDC_MODE="demo"
ONDC_API_URL="https://staging.gateway.ondc.org"
ONDC_API_KEY=""

# Server Ports & URLs
PORT=3000
ADMIN_PORT=5174
APP_URL="http://localhost:3000"
