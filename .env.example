# ==============================================================================
# KALAtech Environment Configuration Example
# Copy this file to .env and configure your database and API keys
# ==============================================================================

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalatech?schema=public"

# Google Gemini API Key (Multimodal craft cataloging, translation, pricing vision)
GEMINI_API_KEY="your_gemini_api_key_here"

# Server Ports
PORT=3000
ADMIN_PORT=5174

# Application URL
APP_URL="http://localhost:3000"
